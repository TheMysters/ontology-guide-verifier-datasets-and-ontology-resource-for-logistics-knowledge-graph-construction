<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns="http://example.org/internal-logistics#"
    xml:base="http://example.org/internal-logistics"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#">

  <owl:Ontology rdf:about="http://example.org/internal-logistics">
    <owl:versionIRI rdf:resource="http://example.org/internal-logistics/2.0"/>
    <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <rdfs:label xml:lang="en">Internal Logistics Ontology</rdfs:label>
    <owl:versionInfo>2.0</owl:versionInfo>
    <rdfs:comment xml:lang="en">
      Warehouse-oriented ontology. Version 2.0.
      IOF Core is NOT imported here to keep the file self-contained in Protege.
      IOF anchors (MaterialEntity, Agent, Process) are declared as local stub
      classes with their intended IOF IRI recorded in rdfs:comment. When the
      full IOF Core import is needed for reasoning, uncomment the owl:imports
      line below and remove the stub declarations in Section 0.

      Intended IOF import (disabled):
        https://spec.industrialontologies.org/ontology/core/Core/

      Key design decisions (v2):
        [D1] ProductFamily, ProductSubfamily, ABCClass, HazardCategory anchor
             to skos:Concept (open-world classification). New codes are added
             as data, not as schema edits.
        [D2] belongsToFamily removed; family reached via
             belongsToSubfamily then skos:broader.
        [D3] hasABCClass and hasHazardCategory renamed to hasABCClassRef /
             hasHazardCategoryRef with typed ranges.
        [D4] hasPurchaseUnit added (maps to Cdt achat column).
        [D5] hasDesignation added (maps to Designation column).
        [D6] ProductTaxonomyScheme ConceptScheme root individual added.
        [D7] classifiesProduct inverse property added (renamed from isSubfamilyOf in v2.1).
        [D8] locatedIn domain widened to PhysicalLocation.
    </rdfs:comment>
  </owl:Ontology>


  <!-- ============================================================
       SECTION 0 - IOF CORE STUB CLASSES
       These are local stand-ins for IOF Core concepts.
       They carry the intended IOF IRI in rdfs:seeAlso so the
       link is documented without triggering a remote fetch.
       Remove these stubs and uncomment owl:imports above when
       you want full IOF Core reasoning.
       ============================================================ -->

  <owl:Class rdf:about="http://example.org/internal-logistics#IOF_MaterialEntity">
    <rdfs:label xml:lang="en">Material entity (IOF stub)</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/MaterialEntity"/>
    <owl:disjointWith rdf:resource="http://example.org/internal-logistics#IOF_Process"/>
    <owl:disjointWith rdf:resource="http://example.org/internal-logistics#IOF_Agent"/>
    <rdfs:comment xml:lang="en">
      Local stub for iof-core:MaterialEntity.
      Represents any independently existing material object.
      Used as anchor for LogisticsItem and PhysicalLocation.
      disjointWith IOF_Process and IOF_Agent mirrors the real IOF Core axioms
      so that domain/range safety arguments on storedIn and performedBy hold
      even without the full IOF import.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/internal-logistics#IOF_Agent">
    <rdfs:label xml:lang="en">Agent (IOF stub)</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Agent"/>
    <owl:disjointWith rdf:resource="http://example.org/internal-logistics#IOF_MaterialEntity"/>
    <owl:disjointWith rdf:resource="http://example.org/internal-logistics#IOF_Process"/>
    <rdfs:comment xml:lang="en">
      Local stub for iof-core:Agent.
      Represents any entity capable of acting in the world.
      Used as anchor for LogisticsAgent.
      disjointWith IOF_MaterialEntity and IOF_Process mirrors real IOF axioms.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/internal-logistics#IOF_Process">
    <rdfs:label xml:lang="en">Process (IOF stub)</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Process"/>
    <owl:disjointWith rdf:resource="http://example.org/internal-logistics#IOF_MaterialEntity"/>
    <owl:disjointWith rdf:resource="http://example.org/internal-logistics#IOF_Agent"/>
    <rdfs:comment xml:lang="en">
      Local stub for iof-core:Process.
      Represents any temporal entity that unfolds over time.
      Used as anchor for LogisticsProcess.
      disjointWith IOF_MaterialEntity and IOF_Agent mirrors real IOF axioms.
    </rdfs:comment>
  </owl:Class>


  <!-- ============================================================
       SECTION 1 - PRODUCT AND ITEM HIERARCHY
       Anchor: IOF_MaterialEntity (stub for iof-core:MaterialEntity)

       LogisticsItem
         Product  (abstract - prefer concrete subtypes)
           RawMaterial    [disjoint with FinishedProduct, SparePart]
           FinishedProduct
           SparePart
       ============================================================ -->

  <owl:Class rdf:about="#LogisticsItem">
    <rdfs:subClassOf rdf:resource="#IOF_MaterialEntity"/>
    <rdfs:label xml:lang="en">Logistics item</rdfs:label>
    <rdfs:comment xml:lang="en">
      Any physical item tracked within the internal logistics system.
      Superclass for all movable or storable physical objects.
      Anchored to IOF_MaterialEntity: a Process or Agent cannot be a
      LogisticsItem (enforced by the top-level disjointness axiom).
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Product">
    <rdfs:subClassOf rdf:resource="#LogisticsItem"/>
    <rdfs:label xml:lang="en">Product</rdfs:label>
    <rdfs:comment xml:lang="en">
      A LogisticsItem intended for use, sale, or internal consumption.
      Abstract superclass: prefer instantiating RawMaterial, FinishedProduct,
      or SparePart. Use Product directly only when the subtype cannot be
      determined from available data.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Dimension">
    <rdfs:label xml:lang="en">Dimension</rdfs:label>
    <skos:altLabel xml:lang="en">dimension</skos:altLabel>
    <skos:altLabel xml:lang="fr">dimension</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="#Measurement">
    <rdfs:label xml:lang="en">Measurement</rdfs:label>
    <skos:altLabel xml:lang="en">measurement</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="#DimensionMeasurement">
    <rdfs:subClassOf rdf:resource="#Measurement"/>
    <rdfs:label xml:lang="en">Dimension measurement</rdfs:label>
    <hasDefaultUnit rdf:resource="#Millimetre"/>
  </owl:Class>

  <owl:Class rdf:about="#WeightMeasurement">
    <rdfs:subClassOf rdf:resource="#Measurement"/>
    <rdfs:label xml:lang="en">Weight measurement</rdfs:label>
    <hasDefaultUnit rdf:resource="#Kilogram"/>
  </owl:Class>

  <owl:Class rdf:about="#LengthMeasurement">
    <rdfs:subClassOf rdf:resource="#DimensionMeasurement"/>
    <rdfs:label xml:lang="en">Length measurement</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#WidthMeasurement">
    <rdfs:subClassOf rdf:resource="#DimensionMeasurement"/>
    <rdfs:label xml:lang="en">Width measurement</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#HeightMeasurement">
    <rdfs:subClassOf rdf:resource="#DimensionMeasurement"/>
    <rdfs:label xml:lang="en">Height measurement</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#Unit">
    <rdfs:label xml:lang="en">Unit</rdfs:label>
  </owl:Class>

  <owl:NamedIndividual rdf:about="#Millimetre">
    <rdf:type rdf:resource="#Unit"/>
    <rdfs:label xml:lang="en">millimetre</rdfs:label>
    <skos:altLabel xml:lang="en">millimetre</skos:altLabel>
    <skos:altLabel xml:lang="fr">millimetre</skos:altLabel>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#Centimetre">
    <rdf:type rdf:resource="#Unit"/>
    <rdfs:label xml:lang="en">centimetre</rdfs:label>
    <skos:altLabel xml:lang="en">centimetre</skos:altLabel>
    <skos:altLabel xml:lang="fr">centimetre</skos:altLabel>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#Metre">
    <rdf:type rdf:resource="#Unit"/>
    <rdfs:label xml:lang="en">metre</rdfs:label>
    <skos:altLabel xml:lang="en">metre</skos:altLabel>
    <skos:altLabel xml:lang="en">meter</skos:altLabel>
    <skos:altLabel xml:lang="fr">metre</skos:altLabel>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#Kilogram">
    <rdf:type rdf:resource="#Unit"/>
    <rdfs:label xml:lang="en">kilogram</rdfs:label>
    <skos:altLabel xml:lang="en">kilogram</skos:altLabel>
    <skos:altLabel xml:lang="fr">kilogramme</skos:altLabel>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#Gram">
    <rdf:type rdf:resource="#Unit"/>
    <rdfs:label xml:lang="en">gram</rdfs:label>
    <skos:altLabel xml:lang="en">gram</skos:altLabel>
    <skos:altLabel xml:lang="fr">gramme</skos:altLabel>
  </owl:NamedIndividual>

  <owl:Class rdf:about="#RawMaterial">
    <rdfs:subClassOf rdf:resource="#Product"/>
    <rdfs:label xml:lang="en">Raw material</rdfs:label>
    <rdfs:comment xml:lang="en">
      Input material not yet processed into a finished product.
      Disjoint with FinishedProduct and SparePart.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#FinishedProduct">
    <rdfs:subClassOf rdf:resource="#Product"/>
    <rdfs:label xml:lang="en">Finished product</rdfs:label>
    <rdfs:comment xml:lang="en">
      A product ready for delivery or internal use.
      Disjoint with RawMaterial and SparePart.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#SparePart">
    <rdfs:subClassOf rdf:resource="#Product"/>
    <rdfs:label xml:lang="en">Spare part</rdfs:label>
    <rdfs:comment xml:lang="en">
      A component kept in stock for maintenance or repair purposes.
      Disjoint with RawMaterial and FinishedProduct.
    </rdfs:comment>
  </owl:Class>

  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="#RawMaterial"/>
      <rdf:Description rdf:about="#FinishedProduct"/>
      <rdf:Description rdf:about="#SparePart"/>
    </owl:members>
  </owl:AllDisjointClasses>


  <!-- ============================================================
       SECTION 2 - PHYSICAL LOCATION HIERARCHY
       Anchor: IOF_MaterialEntity

       PhysicalLocation  (abstract)
         Warehouse
         StorageZone        (zone inside a warehouse)
         StorageLocation    (precise slot / shelf / bin / pallet)
           BinLocation
           PalletLocation
       ============================================================ -->

  <owl:Class rdf:about="#PhysicalLocation">
    <rdfs:subClassOf rdf:resource="#IOF_MaterialEntity"/>
    <rdfs:label xml:lang="en">Physical location</rdfs:label>
    <rdfs:comment xml:lang="en">
      A physical space within the logistics system used for storage or movement.
      Abstract superclass for Warehouse, StorageZone, and StorageLocation.
      Anchored to IOF_MaterialEntity so storedIn (range: PhysicalLocation)
      cannot be satisfied by a Process.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Warehouse">
    <rdfs:subClassOf rdf:resource="#PhysicalLocation"/>
    <rdfs:label xml:lang="en">Warehouse</rdfs:label>
    <rdfs:comment xml:lang="en">
      A top-level physical facility containing storage zones and locations.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#StorageZone">
    <rdfs:subClassOf rdf:resource="#PhysicalLocation"/>
    <rdfs:label xml:lang="en">Storage zone</rdfs:label>
    <rdfs:comment xml:lang="en">
      A named zone within a warehouse, defined by storage conditions or
      handling type (e.g. cold storage, bulk area, hazardous goods zone).
      Linked to its parent Warehouse via locatedIn.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#StorageLocation">
    <rdfs:subClassOf rdf:resource="#PhysicalLocation"/>
    <rdfs:label xml:lang="en">Storage location</rdfs:label>
    <rdfs:comment xml:lang="en">
      A precise, addressable storage position: a shelf slot, bin, or pallet
      position. Subclassed into BinLocation and PalletLocation.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#BinLocation">
    <rdfs:subClassOf rdf:resource="#StorageLocation"/>
    <rdfs:label xml:lang="en">Bin location</rdfs:label>
    <rdfs:comment xml:lang="en">
      A storage location intended for small or medium products stored in bins.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#PalletLocation">
    <rdfs:subClassOf rdf:resource="#StorageLocation"/>
    <rdfs:label xml:lang="en">Pallet location</rdfs:label>
    <rdfs:comment xml:lang="en">
      A storage location intended for palletized storage (floor or racking).
    </rdfs:comment>
  </owl:Class>


  <!-- ============================================================
       SECTION 3 - CLASSIFICATION LAYER (SKOS, open-world)
       Anchor: skos:Concept

       All four classification classes subclass skos:Concept.
       New codes from future CSV files are added as new individuals
       with skos:broader links - no schema edits required.

       ProductTaxonomyScheme  (ConceptScheme root)
         ProductFamily        (2-digit code: 50, 51, 54...)
           ProductSubfamily   (2-digit code: 06, 13, 16...)

       ABCClass and HazardCategory are flat concept lists.

       Instance pattern (Turtle):
         :Family_51  a :ProductFamily ;
                     skos:prefLabel "51" ;
                     skos:inScheme  :ProductTaxonomyScheme .
         :Subfamily_13  a :ProductSubfamily ;
                        skos:prefLabel "13" ;
                        skos:broader   :Family_51 ;
                        skos:inScheme  :ProductTaxonomyScheme .
         :ABCClass_C  a :ABCClass ; skos:prefLabel "C" .
         :Hazard_None a :HazardCategory ; skos:prefLabel "Aucun" .
       ============================================================ -->

  <skos:ConceptScheme rdf:about="#ProductTaxonomyScheme">
    <rdfs:label xml:lang="en">Product taxonomy scheme</rdfs:label>
    <skos:prefLabel xml:lang="en">Internal logistics product taxonomy</skos:prefLabel>
    <rdfs:comment xml:lang="en">
      Root ConceptScheme for all ProductFamily and ProductSubfamily individuals.
      Known families: 50 = engine parts, 51 = brake systems,
      54 = external peripherals (tires, fenders, windshields).
      New codes are added as data triples, not as schema changes.
    </rdfs:comment>
  </skos:ConceptScheme>

  <owl:Class rdf:about="#ProductFamily">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Product family</rdfs:label>
    <rdfs:comment xml:lang="en">
      Top-level classification grouping products by functional area.
      Identified by a 2-digit numeric code in the CSV (e.g. 50, 51, 54).
      Instances carry skos:prefLabel with the code and, when known from
      documentation, rdfs:label with the human-readable name.
      All instances declare skos:inScheme :ProductTaxonomyScheme.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#ProductSubfamily">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Product subfamily</rdfs:label>
    <rdfs:comment xml:lang="en">
      Finer-grained classification within a ProductFamily.
      Identified by a 2-digit numeric code (e.g. 06, 13, 16).
      Each instance carries skos:broader pointing to its parent ProductFamily.
      The hierarchy can extend further using the same skos:broader pattern
      without any schema change.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#ABCClass">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">ABC class</rdfs:label>
    <rdfs:comment xml:lang="en">
      Demand-based consumption category for inventory prioritisation.
      Expected values: A (high), B (medium), C (low), - (unknown).
      Instances created from the Consommation ABC column in the CSV.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#HazardCategory">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Hazard category</rdfs:label>
    <rdfs:comment xml:lang="en">
      Safety classification for storage constraints and zone assignment.
      Expected values: Aucun (none), Inflammable, and others TBD.
      Instances created from the Risques du produit column in the CSV.
    </rdfs:comment>
  </owl:Class>


  <!-- ============================================================
       SECTION 4 - AGENT HIERARCHY
       Anchor: IOF_Agent (stub for iof-core:Agent)

       LogisticsAgent  (abstract)
         Worker
         Robot
       ============================================================ -->

  <owl:Class rdf:about="#LogisticsAgent">
    <rdfs:subClassOf rdf:resource="#IOF_Agent"/>
    <rdfs:label xml:lang="en">Logistics agent</rdfs:label>
    <rdfs:comment xml:lang="en">
      Any agent (human or automated) executing operations in the logistics system.
      Disjoint with LogisticsItem and PhysicalLocation (see axiom below).
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Worker">
    <rdfs:subClassOf rdf:resource="#LogisticsAgent"/>
    <rdfs:label xml:lang="en">Worker</rdfs:label>
    <rdfs:comment xml:lang="en">A human agent performing logistics operations.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Robot">
    <rdfs:subClassOf rdf:resource="#LogisticsAgent"/>
    <rdfs:label xml:lang="en">Robot</rdfs:label>
    <rdfs:comment xml:lang="en">
      An automated agent (AGV, robotic arm, autonomous mobile robot)
      performing logistics operations.
    </rdfs:comment>
  </owl:Class>


  <!-- ============================================================
       TOP-LEVEL DISJOINTNESS
       LogisticsAgent, LogisticsItem, PhysicalLocation are pairwise disjoint.
       ============================================================ -->

  <owl:AllDisjointClasses>
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="#LogisticsAgent"/>
      <rdf:Description rdf:about="#LogisticsItem"/>
      <rdf:Description rdf:about="#PhysicalLocation"/>
    </owl:members>
  </owl:AllDisjointClasses>


  <!-- ============================================================
       SECTION 5 - PROCESS HIERARCHY
       Anchor: IOF_Process (stub for iof-core:Process)

       LogisticsProcess  (abstract)
         TransportProcess
         StorageProcess
         PickingProcess
       ActiveTransport   (defined class via owl:equivalentClass)
       ============================================================ -->

  <owl:Class rdf:about="#LogisticsProcess">
    <rdfs:subClassOf rdf:resource="#IOF_Process"/>
    <rdfs:label xml:lang="en">Logistics process</rdfs:label>
    <rdfs:comment xml:lang="en">
      Any process occurring within the internal logistics system.
      Abstract superclass for TransportProcess, StorageProcess, PickingProcess.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#TransportProcess">
    <rdfs:subClassOf rdf:resource="#LogisticsProcess"/>
    <rdfs:label xml:lang="en">Transport process</rdfs:label>
    <rdfs:comment xml:lang="en">
      A process that physically moves a LogisticsItem from one PhysicalLocation
      to another. Linked via hasOrigin (source) and hasDestination (target).
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#StorageProcess">
    <rdfs:subClassOf rdf:resource="#LogisticsProcess"/>
    <rdfs:label xml:lang="en">Storage process</rdfs:label>
    <rdfs:comment xml:lang="en">
      A process that places and maintains a LogisticsItem in a PhysicalLocation.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#PickingProcess">
    <rdfs:subClassOf rdf:resource="#LogisticsProcess"/>
    <rdfs:label xml:lang="en">Picking process</rdfs:label>
    <rdfs:comment xml:lang="en">
      A process that retrieves a specific LogisticsItem from a StorageLocation
      in response to an order or internal request.
    </rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#ActiveTransport">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="#TransportProcess"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="#moves"/>
            <owl:someValuesFrom rdf:resource="#LogisticsItem"/>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty rdf:resource="#performedBy"/>
            <owl:someValuesFrom rdf:resource="#LogisticsAgent"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:label xml:lang="en">Active transport</rdfs:label>
    <rdfs:comment xml:lang="en">
      Defined class (necessary and sufficient conditions).
      A TransportProcess that moves at least one LogisticsItem AND
      is performed by at least one LogisticsAgent.
      Instances satisfying both restrictions are automatically inferred
      to be ActiveTransport by an OWL DL reasoner (HermiT, Pellet).
      No explicit rdf:type assertion is needed in the data.
    </rdfs:comment>
  </owl:Class>


  <!-- ============================================================
       SECTION 6 - OBJECT PROPERTIES

       6.1  Operational  (movement and execution)
       6.2  Spatial containment
       6.3  Classification links  (product to SKOS concept)
       ============================================================ -->

  <owl:ObjectProperty rdf:about="#moves">
    <rdfs:label xml:lang="en">moves</rdfs:label>
    <rdfs:comment xml:lang="en">
      Relates a TransportProcess to the LogisticsItem it physically moves.
      Also used in the ActiveTransport defined class restriction.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#TransportProcess"/>
    <rdfs:range  rdf:resource="#LogisticsItem"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#performedBy">
    <rdfs:label xml:lang="en">performed by</rdfs:label>
    <rdfs:comment xml:lang="en">
      Relates a LogisticsProcess to the LogisticsAgent that executes it.
      Used in the ActiveTransport defined class restriction.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#LogisticsProcess"/>
    <rdfs:range  rdf:resource="#LogisticsAgent"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasOrigin">
    <rdfs:label xml:lang="en">has origin</rdfs:label>
    <rdfs:comment xml:lang="en">
      Relates a TransportProcess to the PhysicalLocation it starts from.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#TransportProcess"/>
    <rdfs:range  rdf:resource="#PhysicalLocation"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasDestination">
    <rdfs:label xml:lang="en">has destination</rdfs:label>
    <rdfs:comment xml:lang="en">
      Relates a TransportProcess to the PhysicalLocation it moves towards.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#TransportProcess"/>
    <rdfs:range  rdf:resource="#PhysicalLocation"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#storedIn">
    <rdfs:label xml:lang="en">stored in</rdfs:label>
    <rdfs:comment xml:lang="en">
      Relates a LogisticsItem to the PhysicalLocation where it is currently kept.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#LogisticsItem"/>
    <rdfs:range  rdf:resource="#PhysicalLocation"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#locatedIn">
    <rdfs:label xml:lang="en">located in</rdfs:label>
    <rdfs:comment xml:lang="en">
      Relates a StorageZone or StorageLocation to the Warehouse that contains it.
      Domain is restricted to the union of StorageZone and StorageLocation so
      that a Warehouse cannot be stated to be locatedIn itself (which would be
      logically valid but unintended if domain were the full PhysicalLocation).
      FIX v2.1: domain narrowed from PhysicalLocation to
      owl:unionOf(StorageZone StorageLocation).
    </rdfs:comment>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="#StorageZone"/>
          <rdf:Description rdf:about="#StorageLocation"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range  rdf:resource="#Warehouse"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#belongsToSubfamily">
    <rdfs:label xml:lang="en">belongs to subfamily</rdfs:label>
    <rdfs:comment xml:lang="en">
      Relates a Product to its ProductSubfamily classification node.
      The ProductFamily is reached by following skos:broader on the
      ProductSubfamily individual.
      SPARQL: ?p :belongsToSubfamily ?sub . ?sub skos:broader ?fam .
    </rdfs:comment>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range  rdf:resource="#ProductSubfamily"/>
    <owl:inverseOf rdf:resource="#classifiesProduct"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#classifiesProduct">
    <rdfs:label xml:lang="en">classifies product</rdfs:label>
    <rdfs:comment xml:lang="en">
      Inverse of belongsToSubfamily. Renamed from isSubfamilyOf (v2.0)
      which read semantically backwards ("a subfamily is-subfamily-of a product").
      classifiesProduct reads correctly: this subfamily classifies that product.
      Allows querying "which products belong to subfamily 13?" without
      SPARQL inverse-path operators.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#ProductSubfamily"/>
    <rdfs:range  rdf:resource="#Product"/>
    <owl:inverseOf rdf:resource="#belongsToSubfamily"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasABCClassRef">
    <rdfs:label xml:lang="en">has ABC class ref</rdfs:label>
    <rdfs:comment xml:lang="en">
      Relates a Product to its ABCClass individual.
      Maps to the Consommation ABC column in the CSV.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range  rdf:resource="#ABCClass"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasHazardCategoryRef">
    <rdfs:label xml:lang="en">has hazard category ref</rdfs:label>
    <rdfs:comment xml:lang="en">
      Relates a Product to its HazardCategory individual.
      Maps to the Risques du produit column in the CSV.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range  rdf:resource="#HazardCategory"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasUnit">
    <rdfs:label xml:lang="en">has unit</rdfs:label>
    <rdfs:comment xml:lang="en">
      Legacy schema-level unit shortcut. Prefer hasDefaultUnit for schema-level
      conventions and hasMeasurementUnit for measurement instances.
    </rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:domain rdf:resource="#Dimension"/>
    <rdfs:range rdf:resource="#Unit"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasDefaultUnit">
    <rdfs:label xml:lang="en">has default unit</rdfs:label>
    <skos:altLabel xml:lang="en">default unit</skos:altLabel>
    <skos:altLabel xml:lang="en">expressed in</skos:altLabel>
    <skos:altLabel xml:lang="en">measured in</skos:altLabel>
    <rdfs:comment xml:lang="en">
      Relates a measurement schema concept to the default unit stated in client
      documentation. This property represents schema-level conventions, not
      individual measured values.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#Measurement"/>
    <rdfs:range rdf:resource="#Unit"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasMeasurementUnit">
    <rdfs:label xml:lang="en">has measurement unit</rdfs:label>
    <rdfs:comment xml:lang="en">
      Relates a measurement instance to the unit used for its numeric value.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#Measurement"/>
    <rdfs:range rdf:resource="#Unit"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasLengthMeasurement">
    <rdfs:label xml:lang="en">has length measurement</rdfs:label>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range rdf:resource="#LengthMeasurement"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasWidthMeasurement">
    <rdfs:label xml:lang="en">has width measurement</rdfs:label>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range rdf:resource="#WidthMeasurement"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasHeightMeasurement">
    <rdfs:label xml:lang="en">has height measurement</rdfs:label>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range rdf:resource="#HeightMeasurement"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasWeightMeasurement">
    <rdfs:label xml:lang="en">has weight measurement</rdfs:label>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range rdf:resource="#WeightMeasurement"/>
  </owl:ObjectProperty>


  <!-- ============================================================
       SECTION 7 - DATATYPE PROPERTIES

       Property               CSV column          XSD type
       hasProductReference    Reference           xsd:string
       hasDesignation         Designation         xsd:string
       hasWeightKg            Poids               xsd:decimal
       hasLengthMm            Longueur            xsd:decimal
       hasWidthMm             Largeur             xsd:decimal
       hasHeightMm            Hauteur             xsd:decimal
       plannedStorageQuantity Quantite            xsd:integer
       hasPurchaseUnit        Cdt achat           xsd:integer
       annualDemand           Ventes annuelles    xsd:integer
       ============================================================ -->

  <owl:DatatypeProperty rdf:about="#hasProductReference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has product reference</rdfs:label>
    <rdfs:comment xml:lang="en">
      Product code, article reference, or SKU (string).
      Maps to the Reference column (e.g. ABXDDF1044, PURA1555).
      Declared owl:FunctionalProperty: each product individual may have at most
      one reference value. A reasoner will flag duplicate reference assertions
      as an inconsistency during validation.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasDesignation">
    <rdfs:label xml:lang="en">has designation</rdfs:label>
    <rdfs:comment xml:lang="en">
      Human-readable product name or commercial label (string).
      Maps to the Designation column (e.g. DISQUES DE FREIN VL).
      Also set rdfs:label on each product instance for interoperability.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasWeightKg">
    <rdfs:label xml:lang="en">has weight in kilograms</rdfs:label>
    <rdfs:comment xml:lang="en">Product weight in kilograms (decimal). Maps to Poids.</rdfs:comment>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:altLabel xml:lang="en">weight</skos:altLabel>
    <skos:altLabel xml:lang="fr">poids</skos:altLabel>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasNumericValue">
    <rdfs:label xml:lang="en">has numeric value</rdfs:label>
    <rdfs:comment xml:lang="en">Numeric value carried by an explicit measurement node.</rdfs:comment>
    <rdfs:domain rdf:resource="#Measurement"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasDimension">
    <rdfs:label xml:lang="en">has dimension</rdfs:label>
    <rdfs:comment xml:lang="en">
      Super-property for product dimensions expressed as decimal values.
      Used to group length, width, and height measurements.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasLengthMm">
    <rdfs:label xml:lang="en">has length in millimetres</rdfs:label>
    <rdfs:comment xml:lang="en">Product length in millimetres (decimal). Maps to Longueur.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="#hasDimension"/>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:altLabel xml:lang="en">length</skos:altLabel>
    <skos:altLabel xml:lang="fr">longueur</skos:altLabel>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasWidthMm">
    <rdfs:label xml:lang="en">has width in millimetres</rdfs:label>
    <rdfs:comment xml:lang="en">Product width in millimetres (decimal). Maps to Largeur.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="#hasDimension"/>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:altLabel xml:lang="en">width</skos:altLabel>
    <skos:altLabel xml:lang="fr">largeur</skos:altLabel>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasHeightMm">
    <rdfs:label xml:lang="en">has height in millimetres</rdfs:label>
    <rdfs:comment xml:lang="en">Product height in millimetres (decimal). Maps to Hauteur.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="#hasDimension"/>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:altLabel xml:lang="en">height</skos:altLabel>
    <skos:altLabel xml:lang="fr">hauteur</skos:altLabel>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#plannedStorageQuantity">
    <rdfs:label xml:lang="en">planned storage quantity</rdfs:label>
    <rdfs:comment xml:lang="en">
      Quantity of this product planned to be held in storage (integer).
      Maps to the Quantite column.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasPurchaseUnit">
    <rdfs:label xml:lang="en">has purchase unit</rdfs:label>
    <rdfs:comment xml:lang="en">
      Purchase conditioning or minimum order unit (integer).
      Maps to the Cdt achat column (1 = individual, 2 = pair, 5 = box of five).
    </rdfs:comment>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#annualDemand">
    <rdfs:label xml:lang="en">annual demand</rdfs:label>
    <rdfs:comment xml:lang="en">
      Yearly sales volume or internal consumption count (integer).
      Maps to the Ventes annuelles column. Used for ABC classification
      and warehouse slotting priority.
    </rdfs:comment>
    <rdfs:domain rdf:resource="#Product"/>
    <rdfs:range  rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>

</rdf:RDF>
